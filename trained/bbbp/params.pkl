{
    "gpu": 0,
    "data_path": "./data/bbbp.csv",
    "max_data_size": null,
    "test": false,
    "save_dir": "./ckpt",
    "dataset_type": "classification",
    "multiclass_num_classes": 3,
    "split_type": "scaffold_balanced",
    "split_sizes": [
        0.8,
        0.1,
        0.1
    ],
    "num_runs": 1,
    "seed": 59,
    "metric": "auc",
    "quiet": false,
    "log_frequency": 10,
    "show_individual_scores": false,
    "no_cache": false,
    "epochs": 100,
    "batch_size": 256,
    "warmup_epochs": 2.0,
    "init_lr": 0.0001,
    "max_lr": 0.001,
    "final_lr": 0.0001,
    "temperature": 0.1,
    "encoder_name": "CMPNN",
    "ensemble_size": 1,
    "hidden_size": 256,
    "bias": false,
    "depth": 3,
    "dropout": 0.0,
    "activation": "ReLU",
    "ffn_hidden_size": 256,
    "ffn_num_layers": 2,
    "dump_path": "dumped",
    "exp_name": "finetune",
    "exp_id": "bbbp",
    "tokenizer": "/home/dw/lx_project/DFusMol/preprocess/token_id.json",
    "cuda": true,
    "features_scaling": true,
    "minimize_score": false,
    "map_dict": "preprocessed_molecular_bbbp.npy",
    "num_lrs": 1
